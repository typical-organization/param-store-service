{
  "name": "param-store-service",
  "version": "2.2.2",
  "description": "Service to read parameters from AWS Param Store.",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsc -w",
    "build": "tsc",
    "prepare": "npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "author": "PM",
  "license": "MIT",
  "readmeFilename": "README.md",
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "keywords": [
    "NestJS",
    "Nest",
    "AWS",
    "System Manager",
    "SSM",
    "Parameter Store",
    "param store",
    "config service"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/typical-organization/param-store-service"
  },
  "bugs": "https://github.com/typical-organization/param-store-service",
  "peerDependencies": {
    "@aws-sdk/client-ssm": "^3.830.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/core": "^11.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/testing": "^11.1.3",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.20.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.2.0",
    "jest": "30.0.2",
    "prettier": "3.5.3",
    "supertest": "7.1.1",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "tsc-watch": "7.1.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.34.1",
    "aws-sdk-client-mock": "^4.1.0"
  },
  "overrides": {
    "eslint-plugin-n": "^17.20.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint": "^9.29.0"
  }
}
